# Токен бота из Master Bot (https://max.ru/masterbot)
BOT_TOKEN=

# ID владельца бота (опционально). Узнать: напиши боту /myid
# OWNER_ID=

# Путь к SQLite-базе (по умолчанию ./data/bot.db)
# DB_PATH=./data/bot.db

# Веб-админка / mini-app
# WEB_ENABLED=true
# WEB_HOST=127.0.0.1
# WEB_PORT=3010
# WEB_PUBLIC_URL=https://bot.example.com
# WEB_INIT_DATA_MAX_AGE_SEC=3600
# WEB_ADMIN_TOKEN=  # openssl rand -hex 32

# Часовой пояс для расписания тишины (по умолчанию Москва)
# TZ=Europe/Moscow

# LOG_LEVEL=info

# Деплой — см. .env.deploy.example (локальный файл .env.deploy, не коммитить)
